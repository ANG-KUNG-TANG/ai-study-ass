# Copy to .env.docker. Never commit .env.docker.
NODE_ENV=production

# Local compose overrides this with mongodb://mongo:27017/ai_study_assistant.
# Production compose uses this value.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE

# Generate two DIFFERENT values with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-unique-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-unique-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

BCRYPT_ROUNDS=10

AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

APP_URL=http://localhost:3000
COOKIE_DOMAIN=

# Set true only when public traffic reaches this app through Cloudflare Tunnel/proxy.
TRUST_CLOUDFLARE_PROXY=false

RESEND_API_KEY=
EMAIL_FROM="AI Study Assistant <onboarding@resend.dev>"
