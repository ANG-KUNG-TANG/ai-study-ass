# Copy to .env.docker. Never commit .env.docker.
NODE_ENV=production

# Use mongodb://mongo:27017/ai_study_assistant for the bundled local MongoDB,
# or your mongodb+srv:// endpoint to keep using an existing Atlas database.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
REDIS_URL=redis://redis:6379

# Generate two DIFFERENT values with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-unique-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-unique-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

BCRYPT_ROUNDS=10

AI_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_USER_DAILY_REQUEST_LIMIT=0
AI_USER_DAILY_TOKEN_LIMIT=0

# Use localhost when opening emails on this computer. Use the current HTTPS
# trycloudflare.com URL when opening links on another device.
APP_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
COOKIE_DOMAIN=

RESEND_API_KEY=
EMAIL_ENABLED=false
EMAIL_FROM="AI Study Assistant <onboarding@resend.dev>"
EMAIL_REPLY_TO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
