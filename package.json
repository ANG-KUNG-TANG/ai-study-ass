{
  "name": "ai-study-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand && npm run build",
    "docker:build": "docker build -t ai-study-assistant .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:prod": "docker compose -f compose.prod.yaml up --build -d"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@napi-rs/canvas": "^0.1.80",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.25.0",
    "mammoth": "^1.12.0",
    "mongoose": "^9.7.2",
    "next": "16.2.9",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.2.0",
    "resend": "^6.16.0",
    "sooner": "^1.1.4",
    "tau-prolog": "^0.3.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
